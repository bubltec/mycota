{
  "name": "@bubltec/mycota-config",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "mycota-config": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepare": "pnpm run build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.716.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bubltec/mycota",
    "directory": "packages/config"
  }
}
