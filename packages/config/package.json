{
  "name": "@bubltec/mycota-config",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "mycota-config": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepare": "pnpm run build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1136.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "aws-sdk-client-mock": "4.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bubltec/mycota",
    "directory": "packages/config"
  }
}
