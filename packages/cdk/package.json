{
  "name": "@bubltec/mycota-cdk",
  "version": "0.0.0",
  "description": "CDK constructs for mycota: grantSsmConfigRead, EphemeralConfig, MediaBucket, JobQueue, PostgresInstance, SesDomain, and GithubActionsDeployRole.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "lambda-dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-lambda.mjs",
    "prepare": "pnpm run build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "pretest": "pnpm run build",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.4.0"
  },
  "dependencies": {
    "@bubltec/mycota-config": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.2",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bubltec/mycota",
    "directory": "packages/cdk"
  }
}
