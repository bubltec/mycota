{
  "name": "@bubltec/mycota-cdk",
  "version": "0.0.0",
  "description": "CDK constructs for mycota: grantSsmConfigRead, EphemeralConfig, MediaBucket, and JobQueue.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "lambda-dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-lambda.mjs",
    "prepare": "pnpm run build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "pretest": "pnpm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.4.0"
  },
  "dependencies": {
    "@bubltec/mycota-config": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  }
}
